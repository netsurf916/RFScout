# RFScout ESP-IDF defaults
#
# RFScout uses the ESP32-S3 Bluetooth LE controller with the NimBLE host for
# passive advertisement scanning. Keep these defaults in source control so a
# fresh `idf.py set-target esp32s3` produces a usable RFScout image.

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n

# Hotspots supports Wi-Fi Enhanced Open (OWE) associations. Keep station-side
# OWE support enabled so WIFI_AUTH_OWE records can be joined when selected.
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=y

# Supported RFScout ESP32-S3 boards provide external OPI PSRAM. Large working
# sets such as observation history live there rather than consuming the SoC's
# limited internal DRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# The supported RFScout profile uses 16 MB flash. Use the project A/B OTA partition
# table with two 6 MiB application slots and the remaining ~3.94 MiB for LittleFS.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA catalog and firmware acquisition use ESP-IDF HTTPS with the default
# Mozilla-derived root certificate bundle. Hostname verification remains enabled.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DEFAULT_CERTIFICATE_BUNDLE=y

# Remove local paths and build timestamps so release images can be reproduced
# from the same source and ESP-IDF/toolchain inputs.
CONFIG_APP_REPRODUCIBLE_BUILD=y
