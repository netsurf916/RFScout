# RFScout ESP-IDF defaults
#
# RFScout uses the ESP32-S3 Bluetooth LE controller with the NimBLE host for
# passive advertisement scanning. Keep these defaults in source control so a
# fresh `idf.py set-target esp32s3` produces a usable configuration.

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n

# The T-Embed CC1101 Plus includes external PSRAM. Large RFScout working sets
# such as the 1,000-device observation history live there rather than consuming
# the ESP32-S3's limited internal DRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
