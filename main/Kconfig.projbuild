menu "RFScout hardware"

choice RFSCOUT_BOARD
    prompt "RFScout board target"
    default RFSCOUT_BOARD_TEMBED_CC1101_PLUS
    help
        Select the physical board implementation compiled into this firmware image.
        RFScout builds one board target at a time so support for additional hardware
        does not add unused drivers or board code to existing firmware images.

config RFSCOUT_BOARD_TEMBED_CC1101_PLUS
    bool "LILYGO T-Embed CC1101 Plus"

config RFSCOUT_BOARD_TDECK
    bool "LILYGO T-Deck"
    help
        Build the standard T-Deck target. Initial support establishes board geometry,
        capabilities, and shared peripheral pin ownership; keyboard/trackball input,
        SX1262, and ES7210 microphone support are enabled incrementally behind the
        existing service abstractions.

endchoice

endmenu
